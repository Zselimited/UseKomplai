# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in your Supabase dashboard: Project Settings -> API
#
# Note: In Next.js, any env var that must be readable in browser code needs
# the NEXT_PUBLIC_ prefix. That's expected here since this is the publishable
# (anon) key, which is safe to expose to the browser. Never put the
# service_role/secret key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here
